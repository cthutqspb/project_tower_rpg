<ui:UXML xmlns:ui="UnityEngine.UIElements">    
    <ui:VisualElement class="dialogue-overlay" name="root">
        <!-- Тулбар с именем NPC в стиле Osaka -->
        <ui:VisualElement class="dialogue-overlay__toolbar" name="toolbar">
            <ui:Label class="dialogue-overlay__title" name="title" text="ИМЯ СОБЕСЕДНИКА" />
        </ui:VisualElement>

        <!-- Скролл-контейнер для текста реплик -->
        <ui:ScrollView class="dialogue-overlay__scroll-view" name="content-scroll">
            <ui:Label class="dialogue-overlay__npc-text" name="npc-text" text="Реплика NPC..." />
        </ui:ScrollView>
        
        <!-- Динамический конвейер кнопок-ответов игрока -->
        <ui:VisualElement class="dialogue-overlay__options-list" name="options" />
    </ui:VisualElement>
</ui:UXML>


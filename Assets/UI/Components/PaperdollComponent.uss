/* Кукла: контейнер */
.paperdoll__grid {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 8px;
    gap: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
}

/* Верхняя часть: две колонки */
.paperdoll__top {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    flex: 1;
    gap: 12px;
}

/* Левая колонка */
.paperdoll__top-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
}

/* Правая колонка */
.paperdoll__top-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
}

/* Нижняя часть: две колонки */
.paperdoll__bottom {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding-top: 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.paperdoll__bottom-left {
    display: flex;
    flex-direction: row;
    gap: 6px;
}

.paperdoll__bottom-right {
    display: flex;
    flex-direction: row;
    gap: 6px;
}

/* Все слоты */
.paperdoll__grid .slot {
    width: 40px;
    height: 40px;
    background-color: rgba(0, 0, 0, 0.2);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
}

.paperdoll__grid .slot-icon {
    width: 40px;
    height: 40px;
    font-size: 38px;
}

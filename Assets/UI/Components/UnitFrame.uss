.unit-frame {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.unit-frame-main {
    width: 260px;
    padding: 10px;
    background-color: rgba(35, 35, 35, 0.9);
    border-width: 2px;
    border-color: #444444;
    border-radius: 6px;
}

.unit-frame-auras {
    margin-top: 5px;
    width: 100%;
}

<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" engine="UnityEngine.UIElements" editor="UnityEngine.UIElements">
    
    <ui:VisualElement name="root" class="chat-log" picking-mode="Ignore">
        
        <!-- Верхняя панель: Вкладки + Управление -->
        <ui:VisualElement name="toolbar" class="chat-log__toolbar" picking-mode="Position">
            
            <!-- Слева: Контейнер кнопок переключения табов -->
            <ui:VisualElement name="tabs" class="chat-log__tabs" picking-mode="Ignore">
                <ui:Button name="tab-system-btn" class="chat-log__tab-button" text="Система" />
                <ui:Button name="tab-combat-btn" class="chat-log__tab-button" text="Бой" />
                <ui:Button name="tab-world-btn" class="chat-log__tab-button" text="Мир" />
            </ui:VisualElement>
            
            <!-- Справа: Иконка блокировки перемещения лога -->
            <ui:Button name="lock-btn" class="chat-log__lock-icon" />
            
        </ui:VisualElement>
        
        <!-- Лента сообщений -->
        <ui:ScrollView 
            class="chat-log__scroll-view" 
            name="messages-container" 
            mode="Vertical" 
            picking-mode="Ignore"
            show-vertical-scroller="true"
            show-horizontal-scroller="false" />
            
    </ui:VisualElement>
    
</ui:UXML>




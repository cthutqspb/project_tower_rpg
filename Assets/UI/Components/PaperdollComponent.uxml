<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI/Components/Paperdoll.uss" />

    <ui:VisualElement class="paperdoll__grid" name="root">
        
        <!-- Верхняя часть: левая и правая колонки -->
        <ui:VisualElement class="paperdoll__top">
            
            <!-- Левая колонка: голова, шея, тело, кольцо -->
            <ui:VisualElement class="paperdoll__top-left" name="top-left">
                <!-- Слоты будут добавлены в коде -->
            </ui:VisualElement>
            
            <!-- Правая колонка: перчатки, штаны, сапоги, кольцо2 -->
            <ui:VisualElement class="paperdoll__top-right" name="top-right">
                <!-- Слоты будут добавлены в коде -->
            </ui:VisualElement>
            
        </ui:VisualElement>
        
        <!-- Нижняя часть: оружие (левая колонка) и дальнее (правая колонка) -->
        <ui:VisualElement class="paperdoll__bottom">
            
            <!-- Левая колонка: оружие + оффхенд -->
            <ui:VisualElement class="paperdoll__bottom-left" name="bottom-left">
                <!-- Слоты будут добавлены в коде -->
            </ui:VisualElement>
            
            <!-- Правая колонка: дальнее оружие -->
            <ui:VisualElement class="paperdoll__bottom-right" name="bottom-right">
                <!-- Слоты будут добавлены в коде -->
            </ui:VisualElement>
            
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>


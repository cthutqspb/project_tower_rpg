/* ============================================================
   QUEST JOURNAL
   ============================================================ */

.quest-journal {
    flex-direction: column;
    flex-grow: 1;
    padding: 8px;
    background-color: var(--color-surface);
    border-radius: 4px;
}

/* ============================================================
   TOOLBAR
   ============================================================ */
.quest-journal__toolbar {
    flex-direction: row;
    margin-bottom: 8px;
    padding-left: 4px;
}

.quest-journal__toggle {
    color: var(--color-text-dim);
    font-size: 12px;
    flex-direction: row;
    -unity-text-align: middle-left;
}

.quest-journal__toggle:hover {
    color: var(--color-text);
}

/* ============================================================
   КОЛОНКИ
   ============================================================ */
.quest-journal__columns {
    flex-direction: row;
    flex-grow: 1;
    gap: 8px;
}

/* ============================================================
   СПИСОК КВЕСТОВ (30%)
   ============================================================ */
.quest-journal__list {
    width: 30%;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    padding: 4px;
}

/* Заголовок секции (Активные / Выполненные) */
.quest-journal__section-header {
    color: var(--color-text-dim);
    font-size: 11px;
    -unity-font-style: bold;
    margin: 8px 4px 4px 4px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-text-dim);
    opacity: 0.6;
}

/* Кнопка квеста */
.quest-journal__quest-btn {
    background-color: transparent;
    border-width: 0;
    padding: 6px 8px;
    margin: 2px 0;
    color: var(--color-text);
    -unity-text-align: top-left;
    white-space: normal;
    flex-direction: column;
    align-items: flex-start;
}

.quest-journal__quest-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.quest-journal__quest-btn--active {
    background-color: rgba(122, 162, 247, 0.15);
    border-left-width: 2px;
    border-left-color: var(--color-primary);
}

/* Строка заголовка квеста: чекбокс + название */
.quest-journal__header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    width: 100%;
}

.quest-journal__quest-name {
    color: var(--color-text);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
    flex-grow: 1;
}

/* ============================================================
   ЧЕКБОКС ТРЕКИНГА (Toggle)
   ============================================================ */
.quest-journal__track-toggle {
    margin-right: 6px;
    flex-shrink: 0;
}

.quest-journal__track-toggle .unity-toggle__input {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.quest-journal__track-toggle .unity-toggle__checkmark {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: var(--color-text-dim);
    border-radius: 2px;
}

.quest-journal__track-toggle .unity-toggle__checkmark--checked {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
}

.quest-journal__track-toggle .unity-toggle__label {
    display: none;
}

/* Цели в списке */
.quest-journal__objective-mini {
    color: var(--color-text-dim);
    font-size: 11px;
    white-space: normal;
    margin-left: 22px;
    margin-top: 1px;
}

.quest-journal__objective-mini--completed {
    color: var(--color-success);
}

/* ============================================================
   ДЕТАЛИ КВЕСТА (70%)
   ============================================================ */
.quest-journal__details {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    padding: 12px;
}

.quest-journal__title {
    color: var(--color-warning);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    white-space: normal;
}

.quest-journal__description {
    color: var(--color-text);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 16px;
}

.quest-journal__objectives {
    flex-direction: column;
    margin-bottom: 16px;
}

.quest-journal__objective-detail {
    color: var(--color-text);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 4px;
}

.quest-journal__objective-detail--completed {
    color: var(--color-success);
    opacity: 0.7;
}

/* ============================================================
   БЛОК НАГРАДЫ
   ============================================================ */
.quest-journal__reward-block {
    flex-direction: column;
    margin-top: 8px;
}

.quest-journal__reward-header {
    color: var(--color-text-dim);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    margin-top: 6px;
}

.quest-journal__reward-items {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
}

/* ============================================================
   SLOT PREVIEW ВНУТРИ ЖУРНАЛА (как в попапе)
   ============================================================ */
.quest-journal__reward-items .slot-preview {
    flex-direction: row;
    align-items: center;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
    border-width: 2px;
    border-color: transparent;
}

.quest-journal__reward-items .slot-preview .slot {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
}

.quest-journal__reward-items .slot-preview .slot-icon {
    width: 42px;
    height: 42px;
    font-size: 39px;
    -unity-text-align: middle-center;
}

.quest-journal__reward-items .slot-preview__name {
    width: 120px;
    height: 42px;
    margin-left: 6px;
    color: var(--color-text);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-left;
}

/* ============================================================
   НЕ-ПРЕДМЕТЫ (Опыт, Валюта, Способность)
   ============================================================ */
.quest-journal__reward-item {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 4px 6px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
}

.quest-journal__reward-icon {
    color: var(--color-warning);
    font-size: 16px;
}

.quest-journal__reward-name {
    color: var(--color-text);
    font-size: 12px;
}

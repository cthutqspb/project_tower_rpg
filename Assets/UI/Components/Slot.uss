:root {
    /* Цвета классов способностей (только для иконки) */
    --ability-mage-color: var(--osaka-cyan);
    --ability-warrior-color: var(--osaka-red);
    --ability-rogue-color: var(--osaka-yellow);
    --ability-priest-color: var(--osaka-text);
    --ability-default-color: var(--osaka-text-dim);

    /* Состояния валидации */
    --state-out-of-range-opacity: 0.6;
    --state-no-mana-opacity: 0.4;
    --state-invalid-target-opacity: 0.5;


    /* Предметы */
    --item-common-color: var(--osaka-text);
    --item-uncommon-color: var(--osaka-green);
    --item-rare-color: var(--osaka-blue);
    --item-epic-color: var(--osaka-purple);
    --item-legendary-color: var(--osaka-orange);
    --item-artifact-color: var(--osaka-yellow);

     /* ================================================================
       ЦВЕТА ШКОЛ МАГИИ ДЛЯ АУР И СПОСОБНОСТЕЙ
       ================================================================ */
    --school-frost-color: var(--osaka-blue);
    --school-fire-color: var(--osaka-orange);
    --school-arcane-color: var(--osaka-cyan);
    --school-nature-color: var(--osaka-green);
    --school-shadow-color: var(--osaka-purple);
    --school-holy-color: var(--osaka-yellow);
    --school-physical-color: var(--osaka-red);
    --school-default-color: var(--osaka-text-dim);

    /* Полупрозрачные HDR-версии для сочного 2D-свечения (Bloom) */
    --glow-frost: rgba(122, 162, 247, 0.4);
    --glow-fire: rgba(255, 158, 100, 0.45);
    --glow-arcane: rgba(125, 207, 255, 0.5);
    --glow-nature: rgba(158, 206, 106, 0.4);
    --glow-shadow: rgba(187, 154, 247, 0.45);
    --glow-holy: rgba(224, 175, 104, 0.4);
    --glow-physical: rgba(247, 118, 142, 0.35);
}

.ability-mage {
    color: var(--ability-mage-color);
    border-color: var(--ability-mage-color);
}

.ability-warrior {
    color: var(--ability-warrior-color);
    border-color: var(--ability-warrior-color);
}

.ability-rogue {
    color: var(--ability-rogue-color);
    border-color: var(--ability-rogue-color);
}

.ability-priest {
    color: var(--ability-priest-color);
    border-color: var(--ability-priest-color);
}

.ability-default {
    color: var(--ability-default-color);
    border-color: var(--ability-default-color);
}

/* Предметы */

.item-common {
    color: var(--item-common-color);
    border-color: var(--item-common-color);
}

.item-uncommon {
    color: var(--item-uncommon-color);
    border-color: var(--item-uncommon-color);
}

.item-rare {
    color: var(--item-rare-color);
    border-color: var(--item-rare-color);
}

.item-epic {
    color: var(--item-epic-color);
    border-color: var(--item-epic-color);
}

.item-legendary {
    color: var(--item-legendary-color);
    border-color: var(--item-legendary-color);
}

.item-artifact {
    color: var(--item-artifact-color);
    border-color: var(--item-artifact-color);
}

/* ================================================================
   USS-КЛАССЫ ДЛЯ ШКОЛ МАГИИ (УПРАВЛЯЮТ Nerd Font СИМВОЛАМИ)
   ================================================================ */

.element-frost {
    color: var(--school-frost-color);
    border-color: var(--school-frost-color);
    /* 🦾 2D-BLOOM: Делаем контур символа толще и накладываем ледяную неоновую тень */
}

.element-fire {
    color: var(--school-fire-color);
    border-color: var(--school-fire-color);
  }

.element-arcane {
    color: var(--school-arcane-color);
    border-color: var(--school-arcane-color);
  }

.element-nature {
    color: var(--school-nature-color);
    border-color: var(--school-nature-color);
}

.element-shadow {
    color: var(--school-shadow-color);
    border-color: var(--school-shadow-color);
    -unity-text-outline: 1px var(--school-shadow-color);
    text-shadow: 0px 0px 10px var(--glow-shadow);
}

.element-holy {
    color: var(--school-holy-color);
    border-color: var(--school-holy-color);
}

.element-physical {
    color: var(--school-physical-color);
    border-color: var(--school-physical-color);
}

.element-default {
    color: var(--school-default-color);
    border-color: var(--school-default-color);
}

.slot { 
  border-width: 1px;
  border-color: var(--osaka-surface);
}

.slot.hidden {
  display: none;
}

.slot-icon {
  display: flex;
  border-width: 2px;
  position: absolute;
  left: 50%;
  top: 50%;
  text-align: center;
  -unity-text-align: middle-center;
  translate: -50% -50%;
  transition-property: color, border-color;
  transition-duration: .127s;
  transition-timing-function: ease;
}

/* ============================================================
   СОСТОЯНИЯ ВАЛИДАЦИИ (как в WoW)
   ============================================================ */

/* OUT_OF_RANGE - затемнение + красная рамка */
.slot-icon-out-of-range {
    opacity: var(--state-out-of-range-opacity);
    border-width: 3px;
    border-color: var(--osaka-bg);
}

.slot-bind-label-out-of-range {
  color: var(--osaka-red);
}

/* NO_MANA - сильное затемнение + синяя рамка */
.slot-icon-no-mana {
    opacity: var(--state-no-mana-opacity);
    border-width: 3px;
    border-color: var(--osaka-bg);
}

.slot-bind-label-no-mana {
  color: var(--osaka-blue);
}

/* INVALID_TARGET - затемнение + желтая рамка */
.slot-icon-invalid-target {
    opacity: var(--state-invalid-target-opacity);
    border-width: 3px;
    border-color: var(--osaka-bg); 
}

.slot-bind-label-invalid-target {
  color: var(--osaka-red);
}

.slot-active-flash {
  scale: 0.92;
  background-color: rgba(122, 162, 247, 0.4);
  border-color: #7aa2f7;
}

/* ============================================================
   БЛИНК-ВСПЫШКА ГОТОВНОСТИ (Чистый USS на Transitions)
   ============================================================ */

/* 1. Элемент по умолчанию: полностью белый, в центре слота */
.wow-flash-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.85); /* Яркий белый импульс */
    
    opacity: 1;
    scale: 1;

    /* Настраиваем плавное угасание и взрывной вылет */
    transition-property: opacity, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

/* 2. Состояние финиша: элемент мгновенно растворяется и расширяется */
.wow-flash-overlay.animate-blink {
    opacity: 0;
    scale: 1.8; /* Вспышка разлетается в стороны и режется об overflow: hidden */
}

.slot-bind-label {
  display: flex;
  position: absolute;
  bottom: 0;
  font-size: 18px;
  right: 2px;
  transition: .127s;
  -unity-text-outline-width: 1px;
  -unity-text-outline-color: #000000;
  text-shadow: 1px 1px 0px #000000, -1px -1px 0px #000000, 1px -1px 0px #000000, -1px 1px 0px #000000;
}

.slot-bind-label.hidden {
  visibility: hidden;
}

.slot-amount-label {
  display: flex;
}

.slot-duration-label {
  display: flex;
}

.slot-cooldown-overlay {
  display: flex;
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: transparent;
}



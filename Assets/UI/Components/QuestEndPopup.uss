/* ============================================================
   QUEST END POPUP
   ============================================================ */
.quest-end {
    position: absolute;
    background-color: rgba(26, 30, 30, 0.95);
    padding: 12px;
    border-width: 1px;
    border-color: #3a3a3a;
    border-radius: 4px;
    flex-direction: column;
    width: 480px;
    min-height: 280px;
}

.quest-end__header {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 3px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

/* ============================================================
   ЗАГОЛОВОК
   ============================================================ */
.quest-end__title {
    color: var(--color-warning);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.quest-end__quest-name {
    color: var(--color-text);
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    white-space: normal;
}

/* ============================================================
   БЛОК НАГРАДЫ
   ============================================================ */
.quest-end__reward-block {
    flex-direction: column;
    margin-bottom: 16px;
    flex-grow: 1;
}

.quest-end__reward-header {
    color: var(--color-text-dim);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.quest-end__rewards {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
    min-height: 60px;
}

/* Таблица по 2 в строке */
.quest-end__rewards > .slot-preview {
    flex-basis: calc(50% - 4px);
    flex-grow: 0;
    flex-shrink: 0;
}

/* ============================================================
   SLOT PREVIEW (внутри попапа)
   ============================================================ */
.quest-end__rewards .slot-preview {
    flex-direction: row;
    align-items: center;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
    border-width: 2px;
    border-color: transparent;
}

.quest-end__rewards .slot-preview--choice {
    border-color: var(--color-warning);
}

.quest-end__rewards .slot-preview--choice:hover {
    background-color: rgba(0, 0, 0, 0.4);
}

.quest-end__rewards .slot-preview--selected {
    border-color: var(--color-primary);
    background-color: rgba(122, 162, 247, 0.3);
}

/* 🦾 РАЗМЕРЫ СЛОТА ВНУТРИ ПРЕВЬЮ (42x42) */
.quest-end__rewards .slot-preview .slot {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
}

.quest-end__rewards .slot-preview .slot-icon {
    width: 42px;
    height: 42px;
    font-size: 39px;
    -unity-text-align: middle-center;
}

.quest-end__rewards .slot-preview .slot-amount-label {
    font-size: 11px;
    position: absolute;
    bottom: 1px;
    right: 2px;
    color: #ffffff;
    -unity-text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.85);
}

/* Название рядом с иконкой */
.quest-end__rewards .slot-preview__name {
    width: 120px;
    height: 42px;
    margin-left: 6px;
    color: var(--color-text);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-left;
}

/* ============================================================
   НЕ-ПРЕДМЕТЫ (Label с иконкой: опыт, валюта, способность)
   ============================================================ */
.quest-end__reward-item {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 6px 8px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 3px;
    border-width: 2px;
    border-color: transparent;
    flex-basis: calc(50% - 4px);
    flex-grow: 0;
    flex-shrink: 0;
}

.quest-end__reward-item--choice {
    border-color: var(--color-warning);
}

.quest-end__reward-item--choice:hover {
    background-color: rgba(0, 0, 0, 0.45);
}

.quest-end__reward-icon {
    color: var(--color-warning);
    font-size: 18px;
}

.quest-end__reward-name {
    color: var(--color-text);
    font-size: 12px;
}

.quest-end__reward-amount {
    color: var(--color-text-dim);
    font-size: 12px;
    margin-left: 2px;
}

/* ============================================================
   КНОПКА
   ============================================================ */
.quest-end__btn {
    height: 40px;
    background-color: var(--color-primary);
    color: white;
    -unity-font-style: bold;
    font-size: 14px;
    border-radius: 4px;
    border-width: 0;
    flex-shrink: 0;
}

.quest-end__btn:hover {
    background-color: #8fb0ff;
}

.quest-end__btn--disabled {
    background-color: #444;
    color: #888;
}

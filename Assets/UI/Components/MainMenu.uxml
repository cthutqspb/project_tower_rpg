<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Глобальный оверлей меню на весь экран -->
    <ui:VisualElement name="root" class="main-menu">
        
        <!-- Контейнер с кнопками по центру -->
        <ui:VisualElement name="content" class="main-menu__content">
            
            <!-- Заголовок игры -->
            <ui:Label name="title" class="main-menu__title" />
            
            <!-- Стерильный пак кнопок для C# логики -->
            <ui:Button name="btn-continue" class="main-menu__menu-button" />
            <ui:Button name="btn-new-game" class="main-menu__menu-button" />
            <ui:Button name="btn-save" class="main-menu__menu-button" />
            <ui:Button name="btn-load" class="main-menu__menu-button" />
            <ui:Button name="btn-exit" class="main-menu__menu-button" />
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>



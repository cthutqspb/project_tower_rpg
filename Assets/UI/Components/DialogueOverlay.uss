/* Глобальный оверлей контейнер диалога */
.dialogue-overlay {
    /* Оставляем ТОЛЬКО визуал коробки, без позиционирования в мире! */
    width: 100%;
    height: 100%;
    background-color: rgba(26, 27, 38, 0.85); 
    border-width: 1px;
    border-color: rgba(36, 40, 59, 0.7); 
    border-radius: 4px;
    padding: 12px;
    overflow: hidden;
    display: none; /* Включится через C# при ПКМ */
}


/* Верхняя декоративная панель (Тулбар) */
.dialogue-overlay__toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 24px;
    margin-bottom: 6px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom-width: 1px;
    border-color: rgba(36, 40, 59, 0.4);
    background-color: rgba(36, 40, 59, 0.3);
}

/* Имя говорящего NPC */
.dialogue-overlay__title {
    color: rgba(125, 207, 255, 1); /* var(--osaka-cyan) акцент */
    font-size: 12px;
    -unity-font-style: bold;
}

/* Область скролла для реплик NPC */
.dialogue-overlay__scroll-view {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 12px;
}

/* Текст реплики самого NPC */
.dialogue-overlay__npc-text {
    color: rgba(192, 202, 245, 1); /* --osaka-text */
    font-size: 13px;
    white-space: normal; 
    padding: 4px;
    -unity-font-definition: initial; 
}

/* Нижний блок для динамических кнопок игрока */
.dialogue-overlay__options-list {
    flex-shrink: 0;
    flex-direction: column;
    border-top-width: 1px;
    border-color: rgba(36, 40, 59, 0.3);
    padding-top: 6px;
}

/* Кнопки ответов игрока */
.dialogue-overlay__option-button {
    background-color: transparent;
    border-width: 0;
    color: rgba(86, 95, 137, 1); /* --osaka-text-dim */
    text-align: left;
    padding: 6px 4px;
    margin: 0 0 2px 0;
    font-size: 13px;
    white-space: normal;
    -unity-font-definition: initial; 
    transition: color 0.15s;
}

.dialogue-overlay__option-button:hover {
    color: rgba(192, 202, 245, 1); /* Ховер до яркого */
    cursor: link;
}

.dialogue-overlay__option-button {
    color: var(--color-text);
}

.dialogue-overlay__option-button.visited {
    color: var(--color-text-dim);
}

.dialogue-overlay__option-button:hover {
    color: var(--color-warning);
}

/* Кастомизация встроенного скроллбара под общий стиль */
.dialogue-overlay__scroll-view .unity-scroller {
    width: 4px;
    background-color: transparent;
}

.dialogue-overlay__scroll-view .unity-slider__dragger {
    background-color: rgba(86, 95, 137, 0.3); 
    border-radius: 2px;
    border-width: 0;
}

.dialogue-overlay__scroll-view .unity-scroller__low-button,
.dialogue-overlay__scroll-view .unity-scroller__high-button {
    display: none; 
}


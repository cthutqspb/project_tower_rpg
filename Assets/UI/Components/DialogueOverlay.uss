/* Глобальный оверлей контейнер диалога */
.dialogue-overlay {
    width: 100%;
    height: 100%;
    background-color: rgba(26, 27, 38, 0.85); 
    border-width: 1px;
    border-color: rgba(36, 40, 59, 0.7); 
    border-radius: 4px;
    padding: 12px;
    overflow: hidden;
    display: none; 
}

.dialogue-overlay__toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 24px;
    margin-bottom: 6px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom-width: 1px;
    border-color: rgba(36, 40, 59, 0.4);
    background-color: rgba(36, 40, 59, 0.3);
}

.dialogue-overlay__title {
    color: rgba(125, 207, 255, 1); 
    font-size: 12px;
    -unity-font-style: bold;
}

.dialogue-overlay__scroll-view {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 12px;
}

.dialogue-overlay__npc-text {
    color: rgba(192, 202, 245, 1); 
    font-size: 13px;
    white-space: normal; 
    padding: 4px;
    -unity-font-definition: initial; 
}

.dialogue-overlay__options-list {
    flex-shrink: 0;
    flex-direction: column;
    border-top-width: 1px;
    border-color: rgba(36, 40, 59, 0.3);
    padding-top: 6px;
}

/* ============================================================
   КНОПКА ОТВЕТА
   ============================================================ */
.dialogue-overlay__option-button {
    background-color: transparent;
    border-width: 0;
    text-align: left;
    -unity-text-align: middle-left;
    padding: 6px 8px;
    margin: 0 0 2px 0;
    font-size: 13px;
    white-space: normal;
    -unity-font-definition: initial;
    border-radius: 3px; 
    
    /* 🎯 Плавность только для фона (цвет текста меняется в C#) */
    transition: background-color 0.15s; 
    cursor: link;
}

/* Легкая подсветка при наведении */
.dialogue-overlay__option-button:hover {
    background-color: rgba(122, 162, 247, 0.1);
}

/* Кастомизация встроенного скроллбара */
.dialogue-overlay__scroll-view .unity-scroller {
    width: 4px;
    background-color: transparent;
}

.dialogue-overlay__scroll-view .unity-slider__dragger {
    background-color: rgba(86, 95, 137, 0.3); 
    border-radius: 2px;
    border-width: 0;
}

.dialogue-overlay__scroll-view .unity-scroller__low-button,
.dialogue-overlay__scroll-view .unity-scroller__high-button {
    display: none; 
}

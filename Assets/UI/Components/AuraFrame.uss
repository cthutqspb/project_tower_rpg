/* Глобальный контейнер аура-фрейма */
.aura-frame {
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: transparent;
    justify-content: flex-start;
}

/* Контейнер-сетка, выстраивающий иконки подряд в горизонтальный ряд */
.aura-frame__grid {
    width: 100%;
    flex-direction: row;
    gap: 2;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
}

/* 🦾 СТИЛИЗАЦИЯ СЛОТА ПОД АУРУ:
   Переопределяем размеры стандартного .slot из SlotElement, 
   делая баффы аккуратными и компактными (32х32 вместо 42х42), как в WoW! */
.aura-frame__grid .slot {
    width: 34px;
    height: 54px;
    overflow: visible;
}

/* Компактный размер для шрифта-иконки Nerd Font внутри ауры */
.aura-frame__grid .slot-icon {
    width: 34px;
    height: 34px;
    font-size: 27px;
    -unity-text-align: middle-center;
}

/* Счётчик стаков в углу баффа (например, если щитов накопилось 3 штуки) */
.aura-frame__grid .slot-amount-label {
    font-size: 10px;
    position: absolute;
    bottom: 1px;
    right: 2px;
    color: var(--color-text);
    -unity-text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.85);
}

/* Текстовый таймер оставшегося времени ауры (выводится под или прямо на иконке) */
.aura-frame__grid .slot-duration-label {
    font-size: 13px;
    position: absolute;
    width: 100%;
    top: 34px;
    color: var(--osaka-yellow);
    -unity-text-align: middle-center;
    -unity-text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.9);
}

/* 🎯 Состояние "Осталось меньше 10 секунд" */
.aura-frame__grid .slot.aura-critical {
    /* Делаем иконку полупрозрачной (или меняем цвет) */
    opacity: 0.5;
    
    /* Включаем плавный переход */
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

/* Если мы добавим этот класс, прозрачность вернется */
.aura-frame__grid .slot.aura-critical-pulse {
    opacity: 1.0;
}

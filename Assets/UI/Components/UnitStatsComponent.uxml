<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Изолированный контейнер характеристик -->
    <ui:VisualElement class="unit-stats" name="root">
        
        <!-- Группа Первичных Атрибутов (Текущие статы из ECS) -->
        <ui:VisualElement class="unit-stats__group" name="attributes">
            <!-- Сюда C#-код шёлково вставит список атрибутов при отрисовке -->
        </ui:VisualElement>

        <!-- Разделитель для красоты -->
        <ui:VisualElement class="unit-stats__divider" name="stats-divider" />
        
        <!-- Группа Вторичных Боевых Характеристик -->
        <ui:VisualElement class="unit-stats__group" name="combat-stats">
            <ui:Label class="unit-stats__label" name="crit-chance" />
            <ui:Label class="unit-stats__label" name="hit-chance" />
            <ui:Label class="unit-stats__label" name="attack-speed" />
            <ui:Label class="unit-stats__label" name="dodge-chance" />
            <ui:Label class="unit-stats__label" name="parry-chance" />
            <ui:Label class="unit-stats__label" name="armor" />
            <ui:Label class="unit-stats__label" name="magic-resist" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>


/* 🎒 ГЛАВНОЕ ОКНО РЮКЗАКА (Твой BaseWindow) */
.character-window {
    background-color: rgba(26, 30, 30, 0.95);
    padding: 12px;
    position: relative;
    left: 100px;
    top: 100px;
    border-width: 2px;
    border-color: #3a3a3a;
    border-radius: 4px;
    
    /* 🎰 ХАК ВЕБ-ВЕРСТКИ: Говорим окну сжиматься строго по габаритам его контента!
       Благодаря этому окно станет ровно такой ширины, какой ширины наша сетка сумок! */
    align-self: flex-start; 
}

/* Красивый шрифт шапки */
.window-header-label {
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

/* 🎰 ФИКС КОНТЕЙНЕРА СЕТКИ (grid-container из нашего UXML) */
#grid-container {
    /* Намертво блокируем сжатие или растяжение контейнера во все стороны! */
    flex-shrink: 0;
    flex-grow: 0;
}


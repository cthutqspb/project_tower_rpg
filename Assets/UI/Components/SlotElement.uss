/* Базовый квадратный бокс ячейки (44x44 пикселя) */
.base-slot {
    width: 44px;
    height: 44px;
    background-color: #1a1e1e;
    border-width: 1px;
    border-color: #3a3a3a;
    margin: 2px;
    position: relative; /* Чтобы внутренние оверлеи позиционировались абсолютно */
}

/* Иконка растягивается на всю ячейку */
.slot-icon {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #2b2b2b; /* Дефолтная серая заглушка */
}

/* Шторка кулдауна парит поверх иконки, но под текстом */
.slot-cooldown-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.0); /* По умолчанию прозрачная */
}

/* Текст горячей клавиши прибит к левому верхнему углу */
.slot-bind-label {
    position: absolute;
    top: 2px;
    left: 4px;
    color: #ffcc00; /* Сочный золотой MMO-цвет */
    font-size: 10px;
    -unity-font-style: bold;
}

/* Количество предметов в стаке прибито к правому нижнему углу */
.slot-amount-label {
    position: absolute;
    bottom: 2px;
    right: 4px;
    color: #ffffff;
    font-size: 11px;
    -unity-font-style: bold;
}

/* Таймер длительности баффа прибит по центру или внизу */
.slot-duration-label {
    position: absolute;
    bottom: 2px;
    left: 4px;
    color: #00ff66; /* Зеленый таймер ауры */
    font-size: 10px;
}

/* =========================================================================
   🔮 БУДУЩИЕ CSS МОДИФИКАТОРЫ (Твой Blizzard-канон):
   ========================================================================= */

/* Эффект дизейбла: если способность недоступна или нет маны */
.base-slot.disabled .slot-icon {
    -unity-background-image-tint-color: #555555;
    background-color: #151515;
}

/* Если не хватает маны на каст — окрашиваем в багровый */
.base-slot.insufficient-mana .slot-icon {
    background-color: #551111;
}


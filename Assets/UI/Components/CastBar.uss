.cast-bar__text-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
}

.cast-bar__ability-name {
    color: #ffffff;
    font-size: 12px;
    -unity-font-style: bold;
}

.cast-bar__timer {
    color: rgba(204, 204, 204, 1);
    font-size: 12px;
}

.cast-bar__fill {
    /* базовый цвет — если не переопределяется в коде */
    background-color: rgb(255, 178, 0);
}

<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI/HUD/HUD.uss" />

    <ui:VisualElement class="hud" name="root" picking-mode="Ignore">
        
        <!-- Фрейм игрока — левый верхний угол -->
        <ui:VisualElement
            class="hud__frame-slot hud__frame-slot--player"
            name="player-frame-slot"
            picking-mode="Ignore" />
        
        <!-- Фрейм цели — правый верхний угол -->
        <ui:VisualElement
            class="hud__frame-slot hud__frame-slot--target"
            name="target-frame-slot"
            picking-mode="Ignore" />
        
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Главный контейнер HUD -->
    <ui:VisualElement picking-mode="Ignore" name="hud-root" class="hud">
        
        <!-- Чистые слоты-пустышки под фреймы -->
        <!-- Фрейм игрока — в левом верхнем углу -->
        <ui:VisualElement picking-mode="Ignore" name="PlayerFrameSlot" style="position: absolute; left: 20px; top: 20px;" />
        
        <!-- Фрейм цели — в правом верхнем углу -->
        <ui:VisualElement picking-mode="Ignore" name="TargetFrameSlot" style="position: absolute; right: 20px; top: 20px;" />        
    </ui:VisualElement>
</ui:UXML>


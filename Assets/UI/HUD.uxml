<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Главный контейнер HUD -->
    <ui:VisualElement picking-mode="Ignore" name="hud-root" class="hud" style="position: absolute; width: 100%; height: 100%; flex-grow: 1; justify-content: space-between;">
        
        <!-- Чистые слоты-пустышки под фреймы -->
        <ui:VisualElement name="PlayerFrameSlot" />
        <ui:VisualElement name="TargetFrameSlot" style="align-self: flex-end;" />
        
    </ui:VisualElement>
</ui:UXML>


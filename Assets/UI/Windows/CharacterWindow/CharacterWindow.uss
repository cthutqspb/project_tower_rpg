/* 🎒 ГЛАВНОЕ ОКНО */
.character-window {
    position: absolute;
    background-color: rgba(26, 30, 30, 0.95);
    padding: 12px;
    border-width: 1px;
    border-color: #3a3a3a;
    border-radius: 4px;
    flex-direction: column;
    align-self: flex-start;  /* сжимается под контент */
    height: 640px;
}

/* Тело окна — три колонки */
.character-window__content {
    flex-direction: row;
    flex-grow: 1;
    gap: 8px;
}

/* Колонка со статами */
.character-window__stats {
    width: 320px;
    flex-shrink: 0;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
}

/* Колонка с куклой */
.character-window__paperdoll {
    width: 320px;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    min-height: 280px;
}

/* Колонка с инвентарём */
.character-window__inventory {
    width: 320px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    padding: 4px;
    overflow: auto;
    max-height: 100%;
}

.character-window__inventory-grid {
    display: flex;
    justify-content: center;
}

.character-window__inventory-grid .slot {
    margin: 2px;
    width: 42px;
    height: 42px;
}

.character-window__inventory-grid .slot-icon {
    width: 42px;
    height: 42px;
    font-size: 39px;
}

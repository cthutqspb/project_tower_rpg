/* ============================================================
   ITEM SPLIT WINDOW
   ============================================================ */
.item-split {
    position: absolute;
    background-color: rgba(26, 30, 30, 0.95);
    padding: 12px;
    border-width: 1px;
    border-color: #3a3a3a;
    border-radius: 4px;
    flex-direction: column;
    width: 300px;
}

.item-split__header {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 3px;
    margin-bottom: 12px;
}

.item-split__title {
    color: var(--color-warning, #ffb86c);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.item-split__item-info {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    background-color: rgba(0, 0, 0, 0.2);
    padding: 8px;
    border-radius: 4px;
}

.item-split__icon {
    font-size: 32px;
    color: var(--color-primary, #7aa2f7);
    margin-right: 12px;
}

.item-split__name {
    color: var(--color-text, #c0caf5);
    font-size: 13px;
    -unity-font-style: bold;
}

/* ============================================================
   СЛАЙДЕР (ТВОЯ РАБОЧАЯ СТРУКТУРА + ЦВЕТА BG3)
   ============================================================ */
.item-split__slider-container {
    margin-bottom: 16px;
    background-color: rgba(20, 15, 10, 0.6); /* Темный фон BG3 */
    padding: 12px 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #6b4e2e; /* Золотая рамка */
}

.item-split__amount-label {
    color: #e0d0b0;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.item-split__slider {
    flex-grow: 1;
}

/* 🎯 ТРЕК: Твой рабочий размер (без рамок!) */
.item-split__slider .unity-base-slider__tracker {
    background-color: #1a120b; /* Темный */
    border-radius: 4px;
    height: 6px;
}

/* 🎯 ПОЛЗУНОК: Твой рабочий размер (без background-image и border-width!) */
.item-split__slider .unity-base-slider__dragger {
    background-color: #c8a97e; /* Золотой */
    border-radius: 50%;
    width: 16px;
    height: 16px;
    top: 5px; 

    transition-property: left, right, margin-left, transform, translate;
    transition-duration: 0.08s; /* 80 миллисекунд — быстро и плавно */
    transition-timing-function: ease-out;
}

/* ============================================================
   КНОПКИ
   ============================================================ */
.item-split__actions {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.item-split__btn {
    flex-grow: 1;
    height: 36px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 4px;
    background-color: #444;
    color: white;
    -unity-font-style: bold;
    border-width: 0;
}

.item-split__btn:hover {
    background-color: #555;
}

.item-split__btn--primary {
    background-color: var(--color-primary, #7aa2f7);
    color: #000;
}

.item-split__btn--primary:hover {
    background-color: #8fb0ff;
}

<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="item-split" name="root" picking-mode="Position">
        
        <ui:VisualElement class="item-split__header" name="header">
            <ui:Label text="РАЗДЕЛИТЬ" class="item-split__title" />
        </ui:VisualElement>

        <ui:VisualElement class="item-split__item-info">
            <ui:Label name="item-icon" class="item-split__icon" />
            <ui:Label name="item-name" class="item-split__name" />
        </ui:VisualElement>

        <!-- 🎯 Слайдер в стиле BG3 -->
        <ui:VisualElement class="item-split__slider-container">
            <!-- Текст над слайдером -->
            <ui:Label name="amount-label" text="1 / 10" class="item-split__amount-label" />
            
            <!-- Сам слайдер -->
            <ui:SliderInt name="amount-slider" 
              class="item-split__slider" 
              low-value="1" 
              high-value="10" 
              value="1" 
              page-size="1" 
              show-input-field="true" />

        </ui:VisualElement>

        <ui:VisualElement class="item-split__actions">
            <ui:Button name="confirm-btn" text="Разделить" class="item-split__btn item-split__btn--primary" />
            <ui:Button name="cancel-btn" text="Отмена" class="item-split__btn" />
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>

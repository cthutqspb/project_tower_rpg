<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Подключаем наш свежий файл стилей без инлайнов -->
    <ui:Style src="project://database/Assets/UI/Windows/ContainerWindow/ContainerWindow.uss" />

    <!-- Корневой контейнер окна добычи -->
    <ui:VisualElement class="container-window" name="root" picking-mode="Position">
        
        <!-- Хедер-контейнер (сюда встанет HeaderComponent) -->
        <ui:VisualElement name="header" />
        
        <!-- Тело окна добычи -->
        <ui:VisualElement class="container-window__content" name="content">
            
            <!-- Сетка выпавших предметов (StaticGrid создастся в C#) -->
            <ui:ScrollView
              class="container-window__grid-scroll"
              name="grid"   
              movement-type="Elastic"
              elasticity="0.1">
            </ui:ScrollView>
            
            <!-- Подвал окна с кнопкой -->
            <ui:VisualElement class="container-window__footer" name="footer">
              <ui:Button
                class="container-window__take-all-button"
                name="take-all-btn"
                text="ВЗЯТЬ ВСЁ"
              />
            </ui:VisualElement>
            
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>


.hud__frame-slot {
    position: absolute;
    /* общее для всех слотов фреймов */
}

.hud__frame-slot--player {
    left: 20px;
    top: 20px;
}

.hud__frame-slot--target {
    right: 20px;
    top: 20px;
}

/* На будущее — для блокировки драга */
.hud__frame-slot--locked {
    /* визуальная индикация, если нужно */
}

.hud__chat-log {
    position: absolute;
    bottom: 172px;
    left: 24px;
    width: 420px;
    height: 180px;
}


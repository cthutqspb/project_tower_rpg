/* Полностью растягиваем корень HUD поверх ui-layer, копейка в копейку как твоё окно персонажа! */
.hud-root {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 25px;
    background-color: rgba(128, 0, 128, 0.5); /* Наш фиолетовый тест */
    pointer-events: none;
}

